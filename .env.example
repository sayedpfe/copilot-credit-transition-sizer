# --- Auth mode ---
# app   = Entra app registration + application users (unattended, least privilege)
# azcli = delegated tokens via Azure CLI ('az login' first) — NO app registration.
#         The signed-in user needs read access in each environment, e.g. a Power
#         Platform admin who self-elevated to System Administrator (audited, temporary).
AUTH_MODE=app

# --- Entra app registration (client credentials, AUTH_MODE=app only) ---
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000

# Option A: client secret
CLIENT_SECRET=your-client-secret

# Option B: certificate (comment out CLIENT_SECRET to use this)
# Path to a PEM file containing the private key, and the certificate thumbprint
# registered on the app registration.
#CERT_PEM_PATH=./certs/app-key.pem
#CERT_THUMBPRINT=ABCDEF1234567890ABCDEF1234567890ABCDEF12

# --- Environments ---
# Comma-separated Dataverse environment URLs to ingest from.
# Additional per-environment metadata (PPAC environment id / display name for the
# validate command) can be set in config/sizer.config.json under "environments".
ENVIRONMENT_URLS=https://yourorg.crm.dynamics.com,https://yourorg2.crm4.dynamics.com
