{
  "name": "copilot-credit-transition-sizer",
  "version": "1.0.0",
  "description": "Sizes the Copilot Credit purchase required to replace retiring seeded AI Builder credits, based on actual usage from the Dataverse AI Event table or the PPAC AI Builder consumption report. Not an official Microsoft solution.",
  "license": "MIT",
  "author": "Sayed Ali",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayedpfe/copilot-credit-transition-sizer.git"
  },
  "keywords": [
    "ai-builder",
    "copilot-credits",
    "copilot-studio",
    "power-platform",
    "dataverse",
    "licensing",
    "sizing"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sizer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "sizer": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
